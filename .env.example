# Copy this file to .env.local and fill in the keys you have.
# Every key here is optional. If a key is missing, the feature it powers
# is disabled in the UI with a clear "unavailable" message instead of
# crashing or silently failing. Nothing in this file is a real secret.

# --- Supabase (auth, database, storage) ---
# Required for accounts, saved projects, and the dashboard.
# Public and safe to expose in the browser bundle (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used by API routes that need
# elevated access (e.g. the trigger-dispatch endpoint).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI-assisted labeling) ---
# Powers the "Claude proposes a label" step when reviewing uploaded examples.
# Without this, the wizard falls back to fully manual labeling.
ANTHROPIC_API_KEY=

# --- Resend (email trigger action) ---
# Powers the "send an email" trigger action. Without this, that action
# is hidden/disabled in the trigger picker.
RESEND_API_KEY=

# --- Rate limiting / abuse control (optional, recommended in production) ---
# Upstash Redis, used to rate-limit the labeling and dispatch endpoints
# so a single user can't run up the Anthropic/Resend bill. Without this,
# rate limiting falls back to a conservative in-memory limit (fine for
# development, not durable across serverless instances in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
